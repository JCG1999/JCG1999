# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env a git.
# ============================================================

# ---- Entorno del sistema ----
ENVIRONMENT=development   # development | paper | live
LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR

# ---- Base de datos ----
DATABASE_URL=sqlite:///data/trading.db
# Para PostgreSQL: postgresql://user:password@localhost:5432/trading

# ---- Broker: Alpaca (paper trading por defecto) ----
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # paper: paper-api | live: api.alpaca.markets

# ---- Broker: Binance (opcional) ----
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TESTNET=true

# ---- Alertas: Telegram (opcional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Alertas: Email (opcional) ----
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
